# =================================================================
# Daud Fabrics E-Commerce — Environment Variables Template
# =================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git. Only commit this .env.example file.
# =================================================================

# Neon PostgreSQL Database URL
# Get this from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require&channel_binding=require

# Admin Session Secret — generate a strong 64-char random hex string
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=your_64_char_random_hex_secret_here

# Admin seed credentials (used on first deploy to create the admin account)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=your_strong_admin_password_here
